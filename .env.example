# 复制本文件为 .env 后修改

# 数据集根目录 (TrueNAS 上建议 /mnt/tank/apps)
APPS_DIR=/mnt/tank/apps

# Karakeep 对外访问地址 (浏览器要能访问到, 用于登录回调)
NEXTAUTH_URL=http://192.168.1.10:31000

# 会话签名密钥, 生成方法: 在 TrueNAS shell 执行  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# Meilisearch 主密钥, 随便一串长随机字符
MEILI_MASTER_KEY=CHANGE_ME

# Karakeep 的 API Key: 打开 http://NAS:31000 -> Settings -> API Keys 生成后粘贴到这里
KARAKEEP_API_KEY=CHANGE_ME

TZ=Asia/Shanghai
